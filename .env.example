PORT=3000

# Groq (chat, document writing, translation) - free tier, from console.groq.com
GROQ_API_KEY=

# Google Gemini (image generation, camera "take a picture and search") - free tier, from aistudio.google.com/apikey
GEMINI_API_KEY=

# Hugging Face (video generation, free Inference API token) - from huggingface.co/settings/tokens
HF_API_KEY=

# Optional - Nova 3D Studio real model generation provider (leave blank
# to use the free built-in template library instead; see server-additions.js)
THREE_D_API_URL=
THREE_D_API_KEY=

# Optional - raises the free/anonymous rate limit on gen.pollinations.ai's
# real image-to-GLB pipeline (/generate-3d-model). Get an sk_... key at
# enter.pollinations.ai. Leave blank and 3D generation still works, just
# more rate-limited.
POLLINATIONS_API_KEY=
