PORT=3000

# Groq (chat, document writing, translation) - free tier, from console.groq.com
GROQ_API_KEY=

# Google Gemini (image generation, camera "take a picture and search") - free tier, from aistudio.google.com/apikey
GEMINI_API_KEY=

# Hugging Face (video generation, free Inference API token) - from huggingface.co/settings/tokens
HF_API_KEY=

# Optional - a custom 3D generation provider, tried BEFORE Pollinations if set
# (leave both blank to just use Pollinations, the default; see server-additions.js)
THREE_D_API_URL=
THREE_D_API_KEY=

# Optional - raises the free/anonymous rate limit on gen.pollinations.ai's
# real image-to-GLB pipeline (/generate-3d-model). NOTE: unlike Pollinations'
# image endpoint (unlimited free Flux), 3D generation costs Pollen and the
# anonymous tier has a 0 balance - you WILL get "402 PAYMENT_REQUIRED,
# Insufficient balance" on every 3D request until this is set.
# Get a free key: sign in at enter.pollinations.ai (Discord/Google), copy
# your sk_... key from the dashboard. The free registered tier grants
# 1.5 Pollen/week automatically (~15 low-res generations at ~0.1 Pollen
# each) - no credit card needed for that tier.
POLLINATIONS_API_KEY=

# Optional - Tripo Developer API v3 (Nova AI Studio: image/multiview-to-3D,
# convert, segment, rig, retarget). Get a key at platform.tripo3d.ai/api-keys.
# Leave blank and those routes return a clear "not configured" message -
# Pollinations 3D generation above keeps working either way.
TRIPO_API_KEY=
